@page
@model IndexModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Legends Store</title>
    <link rel="stylesheet" href="~/css/site.css">
</head>

<body>
    <main id="container">
        <h1 style="text-align: left;">Destaques e Promoções</h1>
        <section id="highlightArea">
            <div id="caroussel">
                <div id="carousselImg">
                    <img src="~/img/rayman.webp" alt="Image Braba">
                </div>
                <div id=carousselInfo>
                    <div id="carousselName">
                        <h2>Rayman Legends</h2>
                    </div>
                    <div id="carousselPrice">
                        <h2>R$ 29,90</h2>
                    </div>
                </div>
            </div>
        </section>

        <h1>Catálogo</h1>
        <section id="catalogArea">
            <div id="catalogLine">
                <a href="#">
                    <div id="card">
                        <div id="cardImg">
                            <img src="~/img/image.jpg" alt="">
                        </div>
                        <div id="cardInfo">
                            <h3>Rayman Origins</h3>
                            <h3>R$39,90</h3>
                        </div>
                    </div>
                </a>
                <div id="card">
                    <h1>a</h1>
                </div>
                <div id="card">
                    <h1>a</h1>
                </div>
            </div>
        </section>
    </main>
</body>

</html>