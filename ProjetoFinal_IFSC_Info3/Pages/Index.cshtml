@page
@model IndexModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Legends Store</title>
</head>

<body>
    <div id="container">
        <h1 style="text-align: left;">Destaques e Promoções</h1>
        <div id="highlightArea">
            <div id="caroussel">
                <div id="carousselImg">
                    <img src="~/img/image.jpg" alt="Image Braba">
                </div>
                <div id=carousselInfo>
                    <div id="carousselName">
                        <h1>Rayman Legends</h1>
                    </div>
                    <div id="carousselPrice">
                        <h1>R$ 29,90</h1>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>