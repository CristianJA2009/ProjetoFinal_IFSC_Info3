@page
@model IndexModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Jogo";
}

<main id="container">
    <div class="divUser divGame">
        <div class="subDivGame">
            <div class='rowDivGame'>
                <div class='mainTitle altColor'>
                    <h1>Rayman Legends</h1>
                </div>
                <img src="~/img/raymanlegends.jpg">
            </div>
            <div class='rowDivGame'>
                <p>Rayman Legends é um aclamado jogo de plataforma 2D desenvolvido pela Ubisoft Montpellier. Na história, Rayman, Globox e os Teensies são sugados para dentro de pinturas mágicas, embarcando em uma aventura frenética para salvar mundos míticos, resgatar as princesas e derrotar criaturas de pesadelo.</p>
                <div class='gameInfo'>
                    <div class='rowDivGame'>
                        <p>03/09/2013</p>
                    </div>
                    <div class='rowDivGame'>
                        <p>R$ 39,90</p>
                    </div>
                </div>
                <div class='gameInfo'>
                    <div class='rowDivGame'>
                        <p>Plataforma</p>
                    </div>
                    <div class='rowDivGame'>
                        <button>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-cart-icon lucide-shopping-cart"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                            </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>