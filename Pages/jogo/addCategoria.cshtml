@page
@model MeuProjeto.Pages.jogo.addCategoriaModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Adicionar Categoria";
}

<main id="container">
    <form id="categoriaForm" method="post">
        <input type="test" asp-for="CatName" placeholder="Categoria" id="catName" />
        <button type="submit">Enviar</button>
        <span>@ViewData["ErrorMessage"]</span>
    </form>
</main>
