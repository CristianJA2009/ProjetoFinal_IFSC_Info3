@page
@model addGameModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Novo Jogo";
}

<main id="container">
    <form id="gameForm" class="flex column" method="post" enctype="multipart/form-data">
        <input type="text" asp-for="GameName" placeholder="Nome" id="gameName" />
        <input type="text" asp-for="GameDescription" placeholder="Descrição" id="gameDescription" />
        <input type="number" asp-for="GameValue" placeholder="Valor" id="gameValue" step="0.01" min='0'/>
        <label for="gameImg">Capa</label>
        <input type="file" asp-for="GameImg" placeholder="Banner" id="gameImg" />
        <label for="gameBanner">Banner</label>
        <input type="file" asp-for="GameBanner" placeholder="Capa" id="gameBanner" />
        <label for="gameCategory">Categoria</label>
        <select asp-for="GameCategory" id="gameCategory">
            @foreach (var category in Model.Categorias)
            {
                <option style="text-align: center;" value="@category.Id">@category.nome</option>
            }
        </select>
        <button type="submit" id="gameButton">Enviar</button>
    </form>
    <br/>
    <nav style="color: red">@ViewData["ErrorMessage"]</nav>
</main>