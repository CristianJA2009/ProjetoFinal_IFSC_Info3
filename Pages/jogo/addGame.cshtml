@page
@model addGameModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Adicionar novo game";
}

<main id="container">
    <form id="gameForm" method="post">
        <input type="text" asp-for="GameName" placeholder="Nome" id="gameName" />
        <input type="text" asp-for="GameDescription" placeholder="Descrição" id="gameDescription" />
        <input type="number" asp-for="GameValue" placeholder="Valor" id="gameValue" />
        <input type="text" asp-for="GameImg" placeholder="Capa" id="gameImg" />
        <input type="text" asp-for="GameBanner" placeholder="Banner" id="gameBanner" />
        <label for="gameCategory">Categoria</label>
        <select asp-for="GameCategory" id="gameCategory">
            @foreach (var category in Model.Categorias)
            {
                <option value="@category.Id">@category.nome</option>
            }
        </select>
        <button type="submit" id="gameButton">Enviar</button>
    </form>
</main>