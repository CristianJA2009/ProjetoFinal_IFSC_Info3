@page
@model MeuProjeto.Pages.conta.admin.editarUserModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Editar Usuario";
}
@inject Services.UsuarioSessao user

<body class='bodyAlt'>
    <main id="container">
        <form id="gameForm" class='flex column' method="post" enctype="multipart/form-data">
            <input type="text" asp-for="RegisterName" placeholder="Nome" id="gameName" value="@Model.Usuario.nome" />
            <input type="text" asp-for="RegisterEmail" placeholder="Email" id="gameDescription" value="@Model.Usuario.email" />
            <input type="number" asp-for="Pontos" placeholder="Pontos" value="@Model.Usuario.pontos" />
            @if (Model.Usuario.Id.ToString() != user.Id)
            {
                <select asp-for="Tipo">
                    @if (Model.Usuario.tipo == "admin")
                    {
                        <option value="admin" selected>Admin</option>
                        <option value="user">User</option>
                    }
                    else
                    {
                        <option value="user" selected>User</option>
                        <option value="admin">Admin</option>
                    }
                </select>
            }
            <button type="submit" id="gameButton">Enviar</button>
        </form>

        <span style="color: white;">@ViewData["ErrorMessage"]</span>
    </div>
</main>
</body>