@page
@model MeuProjeto.Pages.conta.PerfilModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Perfil";
}

<main id="container">
    <div class='divUser'>
        <div class='mainTitle altColor'>
            <h1>Meu Perfil</h1>
        </div>
        <div class="divAccount">
            @if (Model.Usuario.foto == null)
            {
                <form method="post" enctype="multipart/form-data">
                    <label><input hidden type="file" /><img src="~/img/userImg.png" class='img2' /></label>
                </form>
            }
            else
            {
                <img src="~/uploads/@Model.Usuario.foto" class='img2' />
            }
            <div class="divSide">
                <div class="divRow">
                    <div class="divRow">
                        <div class='altTitle'>
                            <div class='divIco2'>
                                <svg width="45" height="45" viewBox="0 0 45 45" fill="none"
                                     xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <rect width="45" height="45" fill="url(#pattern0_2134_35)" />
                                    <defs>
                                        <pattern id="pattern0_2134_35" patternContentUnits="objectBoundingBox" width="1"
                                                 height="1">
                                            <use xlink:href="#image0_2134_35" transform="scale(0.0111111)" />
                                        </pattern>
                                        <image id="image0_2134_35" width="90" height="90" preserveAspectRatio="none"
                                               xlink:href="data:image/png;base64," />
                                    </defs>
                                </svg>
                                <p>@Model.Usuario.nome</p>
                            </div>
                        </div>
                        <div class='altTitle'>
                            <div class='divIco2'>
                                <svg width="45" height="45" viewBox="0 0 45 45" fill="none"
                                     xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <rect width="45" height="45" fill="url(#pattern0_2134_55)" />
                                    <defs>
                                        <pattern id="pattern0_2134_55" patternContentUnits="objectBoundingBox" width="1"
                                                 height="1">
                                            <use xlink:href="#image0_2134_55" transform="scale(0.0111111)" />
                                        </pattern>
                                        <image id="image0_2134_55" width="90" height="90" preserveAspectRatio="none"
                                               xlink:href="data:image/png;base64," />
                                    </defs>
                                </svg>
                                <p>@Model.Usuario.pontos Pontos</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="divRow">
                    <div class="divRow">
                        <div class='altTitle'>
                            <div class='divIco2'>
                                <svg width="45" height="45" viewBox="0 0 45 45" fill="none"
                                     xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <rect width="45" height="45" fill="url(#pattern0_2134_54)" />
                                    <defs>
                                        <pattern id="pattern0_2134_54" patternContentUnits="objectBoundingBox" width="1"
                                                 height="1">
                                            <use xlink:href="#image0_2134_54" transform="scale(0.0111111)" />
                                        </pattern>
                                        <image id="image0_2134_54" width="90" height="90" preserveAspectRatio="none"
                                               xlink:href="data:image/png;base64," />
                                    </defs>
                                </svg>
                                <p>@Model.Usuario.email</p>
                            </div>
                        </div>
                        <div class='altTitle'>
                            <div class='divIco2'>
                                <svg width="45" height="45" viewBox="0 0 45 45" fill="none"
                                     xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <rect width="45" height="45" fill="url(#pattern0_2134_56)" />
                                    <defs>
                                        <pattern id="pattern0_2134_56" patternContentUnits="objectBoundingBox" width="1"
                                                 height="1">
                                            <use xlink:href="#image0_2134_56" transform="scale(0.0111111)" />
                                        </pattern>
                                        <image id="image0_2134_56" width="90" height="90" preserveAspectRatio="none"
                                               xlink:href="data:image/png;base64," />
                                    </defs>
                                </svg>

                                <p>********</p>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
            <main id="container" class="spaceAlt">
                <div class="mainTitle"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gamepad2-icon lucide-gamepad-2"><line x1="6" x2="10" y1="11" y2="11" /><line x1="8" x2="8" y1="9" y2="13" /><line x1="15" x2="15.01" y1="12" y2="12" /><line x1="18" x2="18.01" y1="10" y2="10" /><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z" /></svg><h1>Minha Biblioteca</h1><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gamepad2-icon lucide-gamepad-2"><line x1="6" x2="10" y1="11" y2="11" /><line x1="8" x2="8" y1="9" y2="13" /><line x1="15" x2="15.01" y1="12" y2="12" /><line x1="18" x2="18.01" y1="10" y2="10" /><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z" /></svg></div>
                <div class="divUser spaceAlt">
                    <div class='divLibrary'>

                        @if (Model.Jogos.Count > 0)
                        {
                            @foreach (var game in Model.Jogos)
                            {
                                <div class='profileGame'>
                                    <img src="~/uploads/@game.capa">
                                    <p>@game.nome</p>
                                </div>
                            }
                        }
                        else
                        {
                            <h3 style="color: white">Não há jogos cadastrados!</h3>
                        }
                    </div>
                </div>
            </div>
        </main>
