@page
@model LoginModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Login";
}

<body class='bodyAlt'>
<main id="container">
    <form id='formRegister' method="post">
    <div class='divUser'>
        <h1>Fazer Login</h1>
        <div class='divIco'>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-at-sign-icon lucide-at-sign"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/></svg>
            <input type='email'  placeholder='Email' asp-for="LoginEmail" id='loginEmail' required>
        </div>
        <div class='divIco'>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-icon lucide-lock"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type='password' placeholder='Senha' asp-for="LoginPassword" id='loginPassword' required></div>
        <button type='input' id='submitBtn'>Entrar</button>
        <span id="loginError" style="color: red">@ViewData["ErrorMessage"]</span>
        </form>
        <h1 class='subForm'>Não tem uma conta? <button type="button" class='subBtn'><a asp-page="/registro/registro">Criar</a></button></h1>
        <h1 class='subForm'><button type="button" class='subBtn'><a asp-page="/perfil/perfil">Conta Debug</a></button></h1>    
    </div>
</main>
</body>