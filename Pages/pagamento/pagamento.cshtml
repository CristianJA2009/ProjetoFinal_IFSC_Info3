@page
@model IndexModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pagamento";
}

<main id="container">
    <div class="subDiv">
        <div class="mainTitle">
            <h1>Pagamento</h1>
        </div>
        <div class="divUser">
            <div class="divWhite">
                <div class="top">
                    <h1>Forma de Pagamento</h1>
                </div>
                <div class="divColumn">
                    <button class="payment-form"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-credit-card-icon lucide-credit-card"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg><p>Cartão de Crédito</p><p class="payment-label">Até 6x Sem Juros...</p></button>
                    <button class="payment-form"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-smartphone-icon lucide-smartphone"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg><p>Pix</p><p class="payment-label">À Vista</p></button>
                    <button class="payment-form"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-plus-icon lucide-circle-plus"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg><p>Adicionar Cartão</p></button>
                </div>
            </div>
            <div class="divWhite">
                <div class="top">
                    <h1>Resumo da Sua Compra</h1>
                </div>
                <div class="divColumn flex column">
                    <div class="order-summary flex row">
                        <div class="summary-img">
                            <img src="~/img/rayman3.jpg" />
                        </div>
                        <div class="summary-info flex column">
                            <div class="summary-flex flex row">
                                <p>Rayman 3 (Ubisoft)</p>
                                <p>
                                    <button>-</button>
                                    <button>+</button>
                                </p>
                            </div>
                            <div class="summary-flex flex row">
                                <p>1 Chave</p>
                                <p>R$ 26,90</p>
                            </div>
                        </div>
                    </div>
                    <div class="order-summary flex row">
                        <div class="summary-img">
                            <img src="~/img/rayman3.jpg" />
                        </div>
                        <div class="summary-info flex column">
                            <div class="summary-flex flex row">
                                <p>Rayman 3 (Ubisoft)</p>
                                <p>
                                    <button>-</button>
                                    <button>+</button>
                                </p>
                            </div>
                            <div class="summary-flex flex row">
                                <p>1 Chave</p>
                                <p>R$ 26,90</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button type='button' id='submitBtn'><a asp-page="#">Finalizar Compra</a></button>
        </div>
    </div>
</main>