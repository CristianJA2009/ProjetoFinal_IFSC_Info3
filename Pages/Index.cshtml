@page
@model IndexModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home Page";
}

@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject Services.UsuarioSessao Usuario

    
@if (Usuario.Tipo == "admin")
{
    <button><a asp-page="/jogo/addGame">Adicionar Jogos</a></button>
}

<main id="container">
    <h1 style="text-align: left;">Destaques e Promoções</h1>
    <section id="highlightArea">
        <div id="caroussel">
            <div id="carousselImg">
                <img src="~/img/rayman.webp" alt="Image Braba">
            </div>
            <div id=carousselInfo>
                <div id="carousselName">
                    <h2>Rayman Legends</h2>
                </div>
                <div id="carousselPrice">
                    <h2>R$ 29,90</h2>
                </div>
            </div>
        </div>
    </section>

    <h1>Catálogo</h1>
    <section id="catalogArea">
        <div id="catalogLine">
            @if (Model.TemJogos)
            {
                @foreach (var game in Model.Jogos)
                {
                    <a asp-page="/jogo/@game.Id">
                        <div id="card">
                            <div id="cardImg">
                                <img src="~/img/jogos/@game.capa" alt="">
                            </div>
                            <div id="cardInfo">
                                <h3>@game.nome</h3>
                                <h3>@game.valor</h3>
                            </div>
                        </div>
                    </a>
                }
            } else
            {
                <h3>Não há jogos cadastrados!</h3>
            }
        </div>

    </section>
</main>
